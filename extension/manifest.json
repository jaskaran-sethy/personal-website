{
  "manifest_version": 3,
  "name": "Insight Extractor helper",
  "version": "1.0.0",
  "description": "Lets Insight Extractor on jaskaransethy.com read a product's Amazon or Flipkart reviews, fetched from your own browser.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jaskaransethy.com/*", "https://www.jaskaransethy.com/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*",
    "https://www.flipkart.com/*"
  ],
  "icons": {
    "128": "icon.png"
  }
}
